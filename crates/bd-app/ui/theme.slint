// Design tokens and icons shared by every screen.

import { Palette } from "std-widgets.slint";

export global Theme {
    // Follows the widget palette, which the window switches between light,
    // dark and the system setting.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> win: dark ? #10141f : #ffffff;
    out property <color> chr: dark ? #0b0e17 : #f2f4f8;
    out property <color> ink: dark ? #e7eaf2 : #141821;
    out property <color> mut: dark ? #8f97aa : #5d6577;
    out property <color> ln: dark ? #232a3a : #e3e6ee;
    out property <color> hov: dark ? #161b29 : #f4f6fb;
    out property <color> acc: dark ? #6d8bff : #1240e0;
    out property <color> accs: dark ? #1a2350 : #e8edff;
    out property <color> ok: dark ? #3fcf8e : #0a8a55;
    out property <color> wa: dark ? #f2b141 : #b86e00;
    out property <color> er: dark ? #ff6b6b : #cc2a2a;
    out property <color> trk: dark ? #1d2333 : #e6e9f1;
    out property <color> vid: dark ? #f27ac0 : #b4237a;
}

// Stroke icons on a 24x24 grid.
