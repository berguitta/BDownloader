export component Icon inherits Path {
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: Theme.mut;
    stroke-width: 1.8px;
    stroke-line-cap: round;
}
