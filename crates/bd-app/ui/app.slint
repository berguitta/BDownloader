// BDownloader main window: custom title bar, sidebar, pages, status bar.

import { ComboBox, TextEdit, LineEdit, Palette } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { Btn, IconBtn, NavItem, HLine } from "widgets.slint";
import { DownloadsPage, DownloadsState, JobRow, KeyValue, Connection, Columns } from "downloads.slint";
import { GrabberPage, GrabberState, GrabRow } from "grabber.slint";
import { AccountsPage, AccountsState, AccountRow } from "accounts.slint";
import { ExtractionPage, ExtractionState, ExtractRow } from "extraction.slint";
import { SettingsPage, SettingsState, SettingItem } from "settings.slint";

export { DownloadsState, JobRow, KeyValue, Connection, Columns, SettingsState, SettingItem, GrabberState, GrabRow, AccountsState, AccountRow, ExtractionState, ExtractRow }

component AddLinksDialog inherits Rectangle {
    in-out property <string> text;
    in property <int> detected;
    callback edited(string);
    callback confirm(string);
    callback cancel();

    background: #00000077;
    // Swallow clicks behind the dialog.
    TouchArea {}

    Rectangle {
        width: min(560px, parent.width - 32px);
        height: 380px;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.ln;
        background: Theme.win;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 10px;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: @tr("Add links"); font-size: 17px; font-weight: 600; color: Theme.ink; }
            Text {
                text: @tr("Paste links, a list, or any text containing links: BDownloader finds them.");
                color: Theme.mut;
                wrap: word-wrap;
            }
            input := TextEdit {
                vertical-stretch: 1;
                text <=> root.text;
                edited(t) => { root.edited(t); }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.detected == 0 ? @tr("No link detected yet") : @tr("{n} link detected" | "{n} links detected" % root.detected);
                    color: root.detected > 0 ? Theme.ok : Theme.mut;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn { text: @tr("Cancel"); clicked => { root.cancel(); } }
                Btn { primary: true; icon: Icons.plus; text: root.detected > 1 ? @tr("Add {} links", root.detected) : @tr("Add"); clicked => { root.confirm(root.text); } }
            }
        }
    }
    init => { input.focus(); }
}

// Small dialog asking for one value (rename, speed limit of a file).
component InputDialog inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in-out property <string> value;
    callback confirm(string);
    callback cancel();
    background: #00000066;
    TouchArea {}
    Rectangle {
        width: min(440px, parent.width - 32px);
        height: 190px;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.ln;
        background: Theme.win;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.ink; }
            Text { text: root.hint; color: Theme.mut; font-size: 12.5px; wrap: word-wrap; }
            field := LineEdit {
                text <=> root.value;
                accepted => { root.confirm(root.value); }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: @tr("Cancel"); clicked => { root.cancel(); } }
                Btn { primary: true; text: @tr("OK"); clicked => { root.confirm(root.value); } }
            }
        }
    }
    init => { field.focus(); }
}

// Window control button (minimize, maximize, close) in the custom title bar.
component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (danger ? #d93030 : Theme.hov) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Icon {
        width: 14px;
        height: 14px;
        commands: root.icon;
        stroke-width: 1.4px;
        stroke: ta.has-hover && root.danger ? white : Theme.ink;
    }
}

// Invisible strip on the window border to resize the frameless window.
component ResizeEdge inherits TouchArea {
    in property <int> direction;
    callback start(int);
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.start(root.direction);
        }
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../../../assets/logo-64.png");
    preferred-width: 1360px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 580px;
    background: Theme.win;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    no-frame: root.custom-frame;

    in property <bool> custom-frame: true;
    in property <string> window-title: "BDownloader";
    in property <bool> is-max;
    in-out property <int> page: 0;
    in property <bool> compact;
    in property <string> nav-badge;
    in property <string> grab-badge;
    in property <string> extract-badge;
    in property <string> status-down;
    in property <string> status-active;
    in property <string> status-queued;
    in property <string> status-folder;
    in property <string> speed-limit-label;
    in property <bool> speed-limited;
    in-out property <string> speed-input;
    in-out property <int> speed-unit: 1;
    in property <string> toast-text;
    in property <bool> toast-visible;

    in-out property <bool> add-dialog-open;
    in-out property <string> add-dialog-text;
    in property <int> add-dialog-detected;
    callback add-dialog-edited(string);
    callback add-dialog-confirm(string);

    in-out property <bool> input-open;
    in property <string> input-title;
    in property <string> input-hint;
    in-out property <string> input-value;
    callback input-confirm(string);

    callback window-drag();
    callback window-resize(int);
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback apply-speed-limit(string, int);
    callback clear-speed-limit();
    callback pause-all();
    callback resume-all();

    // Theme handling: remember the system scheme before overriding it.
    property <bool> system-dark;
    public function apply-theme(mode: int) {
        if mode == 1 {
            Palette.color-scheme = ColorScheme.light;
        } else if mode == 2 {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = root.system-dark ? ColorScheme.dark : ColorScheme.light;
        }
    }
    public function show-speed-popup() {
        speed-popup.show();
    }
    init => {
        root.system-dark = Palette.color-scheme == ColorScheme.dark;
        root.apply-theme(SettingsState.theme-mode);
    }

    VerticalLayout {
        // Title bar, part of the app like Discord.
        Rectangle {
            height: 40px;
            background: Theme.chr;
            HLine { y: parent.height - 1px; }
            drag := TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        root.window-drag();
                    }
                }
                double-clicked => { root.window-toggle-maximize(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Image { width: 22px; height: 22px; source: @image-url("../../../assets/logo-64.png"); }
                    }
                    Text { text: "BDownloader"; font-size: 14px; font-weight: 700; vertical-alignment: center; color: Theme.ink; }
                }
                Text { text: @tr("v0.1 preview"); font-size: 12px; color: Theme.mut; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        size: 30px;
                        tooltip: Theme.dark ? @tr("Switch to light theme") : @tr("Switch to dark theme");
                        icon: Theme.dark ? Icons.sun : Icons.moon;
                        clicked => {
                            SettingsState.theme-mode = Theme.dark ? 1 : 2;
                            root.apply-theme(SettingsState.theme-mode);
                            SettingsState.theme-changed(SettingsState.theme-mode);
                        }
                    }
                }
                if root.custom-frame: HorizontalLayout {
                    WindowButton { icon: Icons.win-min; clicked => { root.window-minimize(); } }
                    WindowButton { icon: root.is-max ? Icons.win-restore : Icons.win-max; clicked => { root.window-toggle-maximize(); } }
                    WindowButton { icon: Icons.win-close; danger: true; clicked => { root.window-close(); } }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // Sidebar.
            Rectangle {
                width: 200px;
                background: Theme.chr;
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.ln; }
                VerticalLayout {
                    padding: 8px;
                    padding-top: 10px;
                    spacing: 2px;
                    NavItem { icon: Icons.dl; text: @tr("Downloads"); badge: root.nav-badge; active: root.page == 0; clicked => { root.page = 0; } }
                    NavItem { icon: Icons.link; text: @tr("Link grabber"); badge: root.grab-badge; active: root.page == 1; clicked => { root.page = 1; } }
                    NavItem { icon: Icons.key; text: @tr("Accounts"); active: root.page == 2; clicked => { root.page = 2; } }
                    NavItem { icon: Icons.box; text: @tr("Extraction"); badge: root.extract-badge; active: root.page == 3; clicked => { root.page = 3; } }
                    NavItem { icon: Icons.gear; text: @tr("Settings"); active: root.page == 4; clicked => { root.page = 4; } }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            if root.page == 0: DownloadsPage { horizontal-stretch: 1; compact: root.compact; }
            if root.page == 1: GrabberPage { horizontal-stretch: 1; }
            if root.page == 2: AccountsPage { horizontal-stretch: 1; }
            if root.page == 3: ExtractionPage { horizontal-stretch: 1; }
            if root.page == 4: SettingsPage { horizontal-stretch: 1; }
        }

        // Status bar.
        Rectangle {
            height: 32px;
            background: Theme.chr;
            HLine { y: 0; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 16px;
                HorizontalLayout { spacing: 4px; Text { text: @tr("Down"); font-size: 12.5px; color: Theme.mut; vertical-alignment: center; } Text { text: root.status-down; font-size: 12.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; } }
                HorizontalLayout { spacing: 4px; Text { text: @tr("Active"); font-size: 12.5px; color: Theme.mut; vertical-alignment: center; } Text { text: root.status-active; font-size: 12.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; } }
                HorizontalLayout { spacing: 4px; Text { text: @tr("Queued"); font-size: 12.5px; color: Theme.mut; vertical-alignment: center; } Text { text: root.status-queued; font-size: 12.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; } }
                HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: @tr("Saving to"); font-size: 12.5px; color: Theme.mut; vertical-alignment: center; }
                    Text { text: root.status-folder; font-size: 12.5px; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
                // Speed control, like the tray button of the mockup.
                speed-button := Rectangle {
                    width: 170px;
                    border-radius: 6px;
                    background: speed-ta.has-hover ? Theme.hov : transparent;
                    speed-ta := TouchArea { mouse-cursor: pointer; clicked => { speed-popup.show(); } }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: end;
                        VerticalLayout { alignment: center; Icon { width: 16px; height: 16px; commands: Icons.gauge; stroke: root.speed-limited ? Theme.wa : Theme.mut; } }
                        Text { text: root.speed-limit-label; font-size: 12.5px; vertical-alignment: center; color: root.speed-limited ? Theme.wa : Theme.ink; }
                    }
                }
            }
        }
    }

    speed-popup := PopupWindow {
        x: root.width - 300px;
        y: root.height - 32px - 230px;
        width: 290px;
        height: 222px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.ln;
            background: Theme.win;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000044;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text { text: @tr("Speed limit"); font-weight: 600; color: Theme.ink; }
                Text { text: @tr("Any value, for all downloads together."); font-size: 12px; color: Theme.mut; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        input-type: decimal;
                        placeholder-text: @tr("e.g. 2.5");
                        text <=> root.speed-input;
                        accepted => { root.apply-speed-limit(root.speed-input, root.speed-unit); speed-popup.close(); }
                    }
                    ComboBox { width: 90px; model: ["KB/s", "MB/s"]; current-index <=> root.speed-unit; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn { primary: true; small: true; text: @tr("Apply"); clicked => { root.apply-speed-limit(root.speed-input, root.speed-unit); speed-popup.close(); } }
                    Btn { small: true; text: @tr("Unlimited"); clicked => { root.clear-speed-limit(); speed-popup.close(); } }
                }
                HLine {}
                HorizontalLayout {
                    spacing: 8px;
                    Btn { small: true; icon: Icons.pause; text: @tr("Pause all"); clicked => { root.pause-all(); speed-popup.close(); } }
                    Btn { small: true; icon: Icons.play; text: @tr("Resume all"); clicked => { root.resume-all(); speed-popup.close(); } }
                }
            }
        }
    }

    if root.add-dialog-open: AddLinksDialog {
        width: 100%;
        height: 100%;
        text <=> root.add-dialog-text;
        detected: root.add-dialog-detected;
        edited(t) => { root.add-dialog-edited(t); }
        confirm(t) => { root.add-dialog-confirm(t); }
        cancel => { root.add-dialog-open = false; }
    }

    if root.input-open: InputDialog {
        width: 100%;
        height: 100%;
        title: root.input-title;
        hint: root.input-hint;
        value <=> root.input-value;
        confirm(v) => { root.input-open = false; root.input-confirm(v); }
        cancel => { root.input-open = false; }
    }

    if root.toast-visible: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 48px - self.height;
        height: 36px;
        border-radius: 8px;
        background: Theme.ink;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            Text { text: root.toast-text; color: Theme.win; font-size: 13.5px; vertical-alignment: center; }
        }
    }

    // Resize borders of the frameless window (not when maximized).
    if root.custom-frame && !root.is-max: Rectangle {
        ResizeEdge { x: 0; y: 0; width: 6px; height: parent.height; mouse-cursor: ew-resize; direction: 6; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 6px; y: 0; width: 6px; height: parent.height; mouse-cursor: ew-resize; direction: 2; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: 0; width: parent.width; height: 4px; mouse-cursor: ns-resize; direction: 0; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: parent.height - 5px; width: parent.width; height: 5px; mouse-cursor: ns-resize; direction: 4; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: 0; width: 10px; height: 10px; mouse-cursor: nwse-resize; direction: 7; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 10px; y: 0; width: 10px; height: 10px; mouse-cursor: nesw-resize; direction: 1; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: 0; y: parent.height - 10px; width: 10px; height: 10px; mouse-cursor: nesw-resize; direction: 5; start(d) => { root.window-resize(d); } }
        ResizeEdge { x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; mouse-cursor: nwse-resize; direction: 3; start(d) => { root.window-resize(d); } }
    }
}
