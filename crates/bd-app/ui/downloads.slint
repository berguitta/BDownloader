// "Downloads" screen: toolbar, filters, live list with configurable columns,
// detail pane.

import { SpinBox, LineEdit, ListView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { Btn, IconBtn, Chip, SegBar, Dot, Cell, HeaderCell, HLine } from "widgets.slint";

export struct JobRow {
    id: int,
    name: string,
    host: string,
    // Favicon of the hoster, empty until fetched.
    icon: image,
    has-icon: bool,
    size: string,
    segs: [float],
    // 0 active, 1 finished, 2 idle, 3 hoster wait timer
    bar-kind: int,
    // Text drawn in the bar (wait countdown).
    bar-label: string,
    percent: string,
    speed: string,
    eta: string,
    status: string,
    // 0 queued, 1 downloading, 4 finished, 5 failed, 6 paused
    status-kind: int,
    selected: bool,
    // HTTP, DDL, VIDEO or AUDIO
    tag: string,
    package: string,
    added: string,
    downloaded: string,
    conns: string,
    priority: int,
    is-archive: bool,
    has-limit: bool,
}

// Which optional columns are shown (Name is always there).
export struct Columns {
    hoster: bool,
    size: bool,
    progress: bool,
    speed: bool,
    eta: bool,
    status: bool,
    package: bool,
    added: bool,
    downloaded: bool,
    connections: bool,
}

export struct KeyValue { key: string, value: string }

export struct Connection { label: string, progress: float, percent: string }

export global DownloadsState {
    in property <[JobRow]> rows;
    in property <int> total-jobs;
    in property <string> count-all;
    in property <string> count-active;
    in property <string> count-queued;
    in property <string> count-paused;
    in property <string> count-finished;
    in property <string> count-failed;
    in property <string> speed-now;
    in property <string> spark-line;
    in property <string> spark-area;
    in-out property <Columns> columns: { hoster: true, size: true, progress: true, speed: true, eta: true, status: true };

    in property <bool> has-selection;
    in property <string> detail-title;
    in property <[KeyValue]> detail-info;
    in property <string> detail-right-title;
    in property <[Connection]> detail-connections;

    in-out property <int> filter: 0;
    in-out property <string> query;
    in-out property <int> parallel: 4;

    callback filter-changed();
    callback parallel-changed(int);
    callback add-links();
    callback start-all();
    callback pause-all();
    callback clear-finished();
    callback select(int);
    callback activate(int);
    callback pause-resume(int);
    callback row-action(int, string);
    callback toggle-column(string);
}

component ColumnsMenu inherits ContextMenuArea {
    Menu {
        MenuItem { title: @tr("Hoster"); checkable: true; checked: DownloadsState.columns.hoster; activated => { DownloadsState.toggle-column("hoster"); } }
        MenuItem { title: @tr("Size"); checkable: true; checked: DownloadsState.columns.size; activated => { DownloadsState.toggle-column("size"); } }
        MenuItem { title: @tr("Progress"); checkable: true; checked: DownloadsState.columns.progress; activated => { DownloadsState.toggle-column("progress"); } }
        MenuItem { title: @tr("Downloaded"); checkable: true; checked: DownloadsState.columns.downloaded; activated => { DownloadsState.toggle-column("downloaded"); } }
        MenuItem { title: @tr("Speed"); checkable: true; checked: DownloadsState.columns.speed; activated => { DownloadsState.toggle-column("speed"); } }
        MenuItem { title: @tr("ETA"); checkable: true; checked: DownloadsState.columns.eta; activated => { DownloadsState.toggle-column("eta"); } }
        MenuItem { title: @tr("Status"); checkable: true; checked: DownloadsState.columns.status; activated => { DownloadsState.toggle-column("status"); } }
        MenuItem { title: @tr("Package"); checkable: true; checked: DownloadsState.columns.package; activated => { DownloadsState.toggle-column("package"); } }
        MenuItem { title: @tr("Connections"); checkable: true; checked: DownloadsState.columns.connections; activated => { DownloadsState.toggle-column("connections"); } }
        MenuItem { title: @tr("Added"); checkable: true; checked: DownloadsState.columns.added; activated => { DownloadsState.toggle-column("added"); } }
        MenuSeparator {}
        MenuItem { title: @tr("Reset columns"); activated => { DownloadsState.toggle-column("reset"); } }
    }
}

component DownloadRow inherits Rectangle {
    in property <JobRow> job;
    in property <bool> compact;
    callback select();
    callback activate();
    callback pause-resume();
    callback action(string);

    height: compact ? 26px : 34px;
    background: job.selected ? Theme.accs : ta.has-hover ? Theme.hov : transparent;

    function status-color() -> color {
        if job.status-kind == 1 { return Theme.acc; }
        if job.status-kind == 4 { return Theme.ok; }
        if job.status-kind == 5 { return Theme.er; }
        return Theme.mut;
    }

    ContextMenuArea {
        Menu {
            MenuItem { title: @tr("Start"); enabled: job.status-kind == 0 || job.status-kind == 6 || job.status-kind == 5; activated => { root.action("start"); } }
            MenuItem { title: @tr("Force start"); enabled: job.status-kind != 1 && job.status-kind != 4; activated => { root.action("force-start"); } }
            MenuItem { title: @tr("Pause"); enabled: job.status-kind == 0 || job.status-kind == 1; activated => { root.action("pause"); } }
            MenuItem { title: @tr("Stop and reset"); enabled: job.status-kind != 4; activated => { root.action("reset"); } }
            MenuItem { title: @tr("Restart from zero"); activated => { root.action("restart"); } }
            MenuSeparator {}
            Menu {
                title: @tr("Priority");
                MenuItem { title: @tr("Highest"); checkable: true; checked: job.priority == 2; activated => { root.action("priority:2"); } }
                MenuItem { title: @tr("High"); checkable: true; checked: job.priority == 1; activated => { root.action("priority:1"); } }
                MenuItem { title: @tr("Normal"); checkable: true; checked: job.priority == 0; activated => { root.action("priority:0"); } }
                MenuItem { title: @tr("Low"); checkable: true; checked: job.priority == -1; activated => { root.action("priority:-1"); } }
                MenuItem { title: @tr("Lowest"); checkable: true; checked: job.priority == -2; activated => { root.action("priority:-2"); } }
            }
            Menu {
                title: @tr("Move");
                MenuItem { title: @tr("To the top"); activated => { root.action("move:top"); } }
                MenuItem { title: @tr("Move up"); activated => { root.action("move:up"); } }
                MenuItem { title: @tr("Move down"); activated => { root.action("move:down"); } }
                MenuItem { title: @tr("To the bottom"); activated => { root.action("move:bottom"); } }
            }
            Menu {
                title: @tr("Connections");
                MenuItem { title: "1"; activated => { root.action("connections:1"); } }
                MenuItem { title: "2"; activated => { root.action("connections:2"); } }
                MenuItem { title: "4"; activated => { root.action("connections:4"); } }
                MenuItem { title: "8"; activated => { root.action("connections:8"); } }
                MenuItem { title: "16"; activated => { root.action("connections:16"); } }
            }
            MenuItem { title: @tr("Speed limit for this file…"); activated => { root.action("file-limit"); } }
            MenuItem { title: @tr("Remove speed limit"); enabled: job.has-limit; activated => { root.action("file-limit:0"); } }
            MenuSeparator {}
            MenuItem { title: @tr("Open file"); enabled: job.status-kind == 4; activated => { root.action("open-file"); } }
            MenuItem { title: @tr("Open folder"); activated => { root.action("open-folder"); } }
            MenuItem { title: @tr("Extract now"); enabled: job.status-kind == 4 && job.is-archive; activated => { root.action("extract"); } }
            Menu {
                title: @tr("Copy");
                MenuItem { title: @tr("Link"); activated => { root.action("copy-link"); } }
                MenuItem { title: @tr("File name"); activated => { root.action("copy-name"); } }
                MenuItem { title: @tr("File path"); activated => { root.action("copy-path"); } }
            }
            MenuItem { title: @tr("Rename…"); activated => { root.action("rename"); } }
            MenuItem { title: @tr("Change folder…"); activated => { root.action("change-folder"); } }
            MenuItem { title: @tr("Properties"); activated => { root.action("properties"); } }
            MenuSeparator {}
            MenuItem { title: @tr("Remove from list"); activated => { root.action("remove"); } }
            MenuItem { title: @tr("Delete with files"); activated => { root.action("delete"); } }
            MenuItem { title: @tr("Remove all finished"); activated => { root.action("clear-finished"); } }
        }

        ta := TouchArea {
            clicked => { root.select(); }
            double-clicked => { root.activate(); }
        }
    }

    HLine { y: parent.height - 1px; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            spacing: 7px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 17px;
                    border-radius: 4px;
                    background: job.tag == "VIDEO" || job.tag == "AUDIO" ? Theme.vid.with-alpha(0.14) : Theme.accs;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: job.tag;
                            font-size: 10.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            color: job.tag == "VIDEO" || job.tag == "AUDIO" ? Theme.vid : Theme.acc;
                        }
                    }
                }
            }
            if job.priority > 0: VerticalLayout { alignment: center; Icon { width: 12px; height: 12px; commands: Icons.up; stroke: Theme.wa; stroke-width: 2.4px; } }
            if job.priority < 0: VerticalLayout { alignment: center; Icon { width: 12px; height: 12px; commands: Icons.chevron-down; stroke: Theme.mut; stroke-width: 2.4px; } }
            Cell { text: job.name; horizontal-stretch: 1; min-width: 0; }
        }
        if DownloadsState.columns.hoster: HorizontalLayout {
            width: 160px;
            spacing: 6px;
            if job.has-icon: VerticalLayout { alignment: center; Image { width: 16px; height: 16px; source: job.icon; } }
            Cell { text: job.host; font-size: 13px; color: Theme.mut; }
        }
        if DownloadsState.columns.package: Cell { text: job.package; width: 140px; font-size: 13px; color: Theme.mut; }
        if DownloadsState.columns.size: Cell { text: job.size; width: 82px; horizontal-alignment: right; }
        if DownloadsState.columns.downloaded: Cell { text: job.downloaded; width: 82px; horizontal-alignment: right; color: Theme.mut; }
        if DownloadsState.columns.progress: HorizontalLayout {
            width: 170px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                SegBar { segs: job.segs; kind: job.bar-kind; label: job.bar-label; bar-height: job.bar-label != "" ? 16px : 12px; }
            }
            Cell { text: job.percent; width: 38px; font-size: 12px; color: Theme.mut; horizontal-alignment: right; }
        }
        if DownloadsState.columns.speed: Cell { text: job.speed; width: 92px; horizontal-alignment: right; }
        if DownloadsState.columns.eta: Cell { text: job.eta; width: 76px; horizontal-alignment: right; }
        if DownloadsState.columns.connections: Cell { text: job.conns; width: 56px; horizontal-alignment: right; color: Theme.mut; }
        if DownloadsState.columns.added: Cell { text: job.added; width: 120px; color: Theme.mut; font-size: 12.5px; }
        if DownloadsState.columns.status: HorizontalLayout {
            width: 190px;
            spacing: 6px;
            if job.status-kind == 1 || job.status-kind == 4 || job.status-kind == 5: VerticalLayout {
                alignment: center;
                Dot { background: root.status-color(); }
            }
            Cell { text: job.status; font-size: 13px; color: root.status-color(); horizontal-stretch: 1; }
        }
        VerticalLayout {
            width: 40px;
            alignment: center;
            IconBtn {
                tooltip: job.status-kind == 6 ? @tr("Resume") : job.status-kind == 5 ? @tr("Retry") : job.status-kind == 4 ? @tr("Open folder") : @tr("Pause");
                icon: job.status-kind == 6 ? Icons.play : job.status-kind == 5 ? Icons.retry : job.status-kind == 4 ? Icons.folder : Icons.pause;
                clicked => {
                    if job.status-kind == 4 {
                        root.action("open-folder");
                    } else {
                        root.pause-resume();
                    }
                }
            }
        }
    }
}

export component DownloadsPage inherits VerticalLayout {
    in property <bool> compact;

    // Toolbar.
    Rectangle {
        height: 52px;
        HLine { y: parent.height - 1px; }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            VerticalLayout { alignment: center; horizontal-stretch: 0; Btn { primary: true; icon: Icons.plus; text: @tr("Add links"); clicked => { DownloadsState.add-links(); } } }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Btn { icon: Icons.play; text: @tr("Start all"); clicked => { DownloadsState.start-all(); } } }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Btn { icon: Icons.pause; text: @tr("Pause all"); clicked => { DownloadsState.pause-all(); } } }
            VerticalLayout { alignment: center; horizontal-stretch: 0; Btn { icon: Icons.trash; text: @tr("Remove finished"); clicked => { DownloadsState.clear-finished(); } } }
            VerticalLayout { alignment: center; Rectangle { width: 1px; height: 24px; background: Theme.ln; } }
            Text { text: @tr("Parallel"); font-size: 13px; color: Theme.mut; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 50;
                    value <=> DownloadsState.parallel;
                    edited(v) => { DownloadsState.parallel-changed(v); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 150px;
                    height: 34px;
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 150;
                        viewbox-height: 34;
                        commands: DownloadsState.spark-area;
                        fill: Theme.acc.with-alpha(0.16);
                        stroke: transparent;
                    }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 150;
                        viewbox-height: 34;
                        commands: DownloadsState.spark-line;
                        fill: transparent;
                        stroke: Theme.acc;
                        stroke-width: 1.6px;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                width: 100px;
                Text { text: DownloadsState.speed-now; font-size: 18px; font-weight: 600; horizontal-alignment: right; color: Theme.ink; }
                Text { text: @tr("last 60 s"); font-size: 12px; horizontal-alignment: right; color: Theme.mut; }
            }
        }
    }

    // Filters.
    Rectangle {
        height: 44px;
        HLine { y: parent.height - 1px; }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            VerticalLayout { alignment: center; Chip { text: @tr("All"); count: DownloadsState.count-all; active: DownloadsState.filter == 0; clicked => { DownloadsState.filter = 0; DownloadsState.filter-changed(); } } }
            VerticalLayout { alignment: center; Chip { text: @tr("Active"); count: DownloadsState.count-active; active: DownloadsState.filter == 1; clicked => { DownloadsState.filter = 1; DownloadsState.filter-changed(); } } }
            VerticalLayout { alignment: center; Chip { text: @tr("Queued"); count: DownloadsState.count-queued; active: DownloadsState.filter == 2; clicked => { DownloadsState.filter = 2; DownloadsState.filter-changed(); } } }
            VerticalLayout { alignment: center; Chip { text: @tr("Paused"); count: DownloadsState.count-paused; active: DownloadsState.filter == 3; clicked => { DownloadsState.filter = 3; DownloadsState.filter-changed(); } } }
            VerticalLayout { alignment: center; Chip { text: @tr("Finished"); count: DownloadsState.count-finished; active: DownloadsState.filter == 4; clicked => { DownloadsState.filter = 4; DownloadsState.filter-changed(); } } }
            VerticalLayout { alignment: center; Chip { text: @tr("Errors"); count: DownloadsState.count-failed; active: DownloadsState.filter == 5; clicked => { DownloadsState.filter = 5; DownloadsState.filter-changed(); } } }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                LineEdit {
                    width: 240px;
                    placeholder-text: @tr("Filter by name or hoster");
                    text <=> DownloadsState.query;
                    edited => { DownloadsState.filter-changed(); }
                }
            }
        }
    }

    // Column header: right-click to choose the columns.
    Rectangle {
        height: 30px;
        background: Theme.chr;
        HLine { y: parent.height - 1px; }
        ColumnsMenu {
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                HeaderCell { text: @tr("Name"); horizontal-stretch: 1; }
                if DownloadsState.columns.hoster: HeaderCell { text: @tr("Hoster"); width: 160px; }
                if DownloadsState.columns.package: HeaderCell { text: @tr("Package"); width: 140px; }
                if DownloadsState.columns.size: HeaderCell { text: @tr("Size"); width: 82px; horizontal-alignment: right; }
                if DownloadsState.columns.downloaded: HeaderCell { text: @tr("Downloaded"); width: 82px; horizontal-alignment: right; }
                if DownloadsState.columns.progress: HeaderCell { text: @tr("Progress"); width: 170px; }
                if DownloadsState.columns.speed: HeaderCell { text: @tr("Speed"); width: 92px; horizontal-alignment: right; }
                if DownloadsState.columns.eta: HeaderCell { text: @tr("ETA"); width: 76px; horizontal-alignment: right; }
                if DownloadsState.columns.connections: HeaderCell { text: @tr("Conn."); width: 56px; horizontal-alignment: right; }
                if DownloadsState.columns.added: HeaderCell { text: @tr("Added"); width: 120px; }
                if DownloadsState.columns.status: HeaderCell { text: @tr("Status"); width: 190px; }
                VerticalLayout {
                    width: 40px;
                    alignment: center;
                    IconBtn { size: 24px; icon: Icons.columns; tooltip: @tr("Choose columns (right-click)"); }
                }
            }
        }
    }

    // List, or an empty state.
    Rectangle {
        vertical-stretch: 1;
        if DownloadsState.total-jobs == 0: VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                Icon { width: 40px; height: 40px; commands: Icons.dl; stroke: Theme.mut; stroke-width: 1.4px; }
            }
            Text { text: @tr("No downloads yet"); font-size: 16px; font-weight: 600; horizontal-alignment: center; color: Theme.ink; }
            Text { text: @tr("Click Add links and paste one or more links, or a whole block of text."); horizontal-alignment: center; color: Theme.mut; }
            HorizontalLayout {
                alignment: center;
                Btn { primary: true; icon: Icons.plus; text: @tr("Add links"); clicked => { DownloadsState.add-links(); } }
            }
        }
        if DownloadsState.total-jobs > 0: ListView {
            width: 100%;
            height: 100%;
            for job[i] in DownloadsState.rows: DownloadRow {
                job: job;
                compact: root.compact;
                select => { DownloadsState.select(i); }
                activate => { DownloadsState.activate(i); }
                pause-resume => { DownloadsState.pause-resume(i); }
                action(name) => { DownloadsState.row-action(i, name); }
            }
        }
    }

    // Detail pane.
    if DownloadsState.has-selection: Rectangle {
        height: 180px;
        background: Theme.chr;
        HLine { y: 0; }
        HorizontalLayout {
            padding: 14px;
            padding-top: 12px;
            spacing: 18px;
            VerticalLayout {
                horizontal-stretch: 11;
                spacing: 6px;
                Text { text: DownloadsState.detail-title; font-size: 15px; font-weight: 600; color: Theme.ink; overflow: elide; }
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        spacing: 3px;
                        for kv in DownloadsState.detail-info: Text { text: kv.key; font-size: 13px; color: Theme.mut; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        for kv in DownloadsState.detail-info: Text { text: kv.value; font-size: 13px; color: Theme.ink; overflow: elide; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            VerticalLayout {
                horizontal-stretch: 10;
                spacing: 5px;
                Text { text: DownloadsState.detail-right-title; font-size: 13px; font-weight: 600; color: Theme.mut; }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 5px;
                        for c in DownloadsState.detail-connections: HorizontalLayout {
                            spacing: 8px;
                            height: 14px;
                            Text { text: c.label; width: 60px; font-size: 12px; color: Theme.mut; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                SegBar { segs: [c.progress]; kind: c.progress >= 1 ? 1 : 0; bar-height: 10px; }
                            }
                            Text { text: c.percent; width: 48px; font-size: 12px; color: Theme.mut; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
