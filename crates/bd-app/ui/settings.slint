// Settings: sections on the left, searchable list of options on the right,
// generated from the schema in src/schema.rs.

import { ComboBox, SpinBox, LineEdit, Switch, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { Btn, Pill, HLine } from "widgets.slint";

export struct SettingItem {
    id: string,
    label: string,
    hint: string,
    // Longer explanation behind the "i" button.
    info: string,
    // 0 toggle, 1 number, 2 select, 3 text, 4 folder, 5 module
    kind: int,
    flag: bool,
    number: int,
    text: string,
    options: [string],
    option-index: int,
    unit: string,
    min: int,
    max: int,
    // 0 ready, 1 needs a restart, 2 planned
    status: int,
    advanced: bool,
    // Section title shown above the first match when searching.
    group: string,
    first-in-group: bool,
}

export struct RuleRow {
    enabled: bool,
    // index in the days list
    days: int,
    from: string,
    to: string,
    // index in the actions list
    action: int,
    value: int,
}

export global SettingsState {
    in property <[RuleRow]> rules;
    callback rule-changed(int, string, string);
    callback rule-add();
    callback rule-remove(int);
    in property <[string]> categories;
    in-out property <int> category;
    in-out property <string> search;
    in-out property <bool> show-advanced;
    in property <[SettingItem]> items;
    in property <int> hidden-advanced;
    in property <string> yt-dlp-status;
    in property <bool> yt-dlp-installed;
    in property <string> ffmpeg-status;
    in property <bool> ffmpeg-installed;
    in property <bool> tool-busy;
    in property <string> config-path;
    // Kept for the title bar theme button.
    in-out property <int> theme-mode;

    callback category-selected(int);
    callback search-changed();
    callback show-advanced-changed(bool);
    callback item-changed(string, string);
    callback browse(string);
    callback reset-page();
    callback copy-json();
    callback install-tool(string);
    callback theme-changed(int);
}

component CategoryItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: active ? Theme.accs : ta.has-hover ? Theme.hov : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.acc : ta.has-hover ? Theme.ink : Theme.mut;
        }
    }
}

component ItemRow inherits Rectangle {
    in property <SettingItem> item;
    property <bool> show-info;
    min-height: 58px;
    HLine { y: parent.height - 1px; }
    HorizontalLayout {
        spacing: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: item.label; font-weight: 500; color: item.status == 2 ? Theme.mut : Theme.ink; wrap: word-wrap; }
                if item.info != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: info-ta.has-hover || root.show-info ? Theme.accs : transparent;
                        info-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-info = !root.show-info; } }
                        Icon { width: 15px; height: 15px; commands: Icons.info; stroke: root.show-info ? Theme.acc : Theme.mut; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if item.advanced: VerticalLayout { alignment: center; Pill { text: @tr("advanced"); tone: Theme.mut; } }
                if item.status == 1: VerticalLayout { alignment: center; Pill { text: @tr("after restart"); tone: Theme.acc; } }
                if item.status == 2: VerticalLayout { alignment: center; Pill { text: @tr("Planned"); } }
            }
            if item.hint != "": Text { text: item.hint; font-size: 12.5px; color: Theme.mut; wrap: word-wrap; }
            if root.show-info: Rectangle {
                border-radius: 8px;
                background: Theme.accs;
                HorizontalLayout {
                    padding: 8px;
                    Text { text: item.info; font-size: 12.5px; color: Theme.ink; wrap: word-wrap; }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            width: 300px;
            if item.kind == 0 || item.kind == 5: VerticalLayout {
                alignment: center;
                Switch {
                    checked: item.flag;
                    enabled: item.status != 2;
                    toggled => { SettingsState.item-changed(item.id, self.checked ? "true" : "false"); }
                }
            }
            if item.kind == 1: HorizontalLayout {
                spacing: 6px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    SpinBox {
                        width: 150px;
                        minimum: item.min;
                        maximum: item.max;
                        value: item.number;
                        enabled: item.status != 2;
                        edited(v) => { SettingsState.item-changed(item.id, v); }
                    }
                }
                Text { text: item.unit; color: Theme.mut; font-size: 13px; vertical-alignment: center; min-width: 40px; }
            }
            if item.kind == 2: VerticalLayout {
                alignment: center;
                ComboBox {
                    width: 260px;
                    model: item.options;
                    current-index: item.option-index;
                    enabled: item.status != 2;
                    selected => { SettingsState.item-changed(item.id, self.current-index); }
                }
            }
            if item.kind == 3: VerticalLayout {
                alignment: center;
                LineEdit {
                    width: 260px;
                    text: item.text;
                    enabled: item.status != 2;
                    edited(t) => { SettingsState.item-changed(item.id, t); }
                }
            }
            if item.kind == 6: VerticalLayout {
                alignment: center;
                Btn { small: true; text: item.text; clicked => { SettingsState.item-changed(item.id, "click"); } }
            }
            if item.kind == 4: HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    LineEdit {
                        width: 220px;
                        text: item.text;
                        edited(t) => { SettingsState.item-changed(item.id, t); }
                    }
                }
                VerticalLayout { alignment: center; Btn { small: true; text: @tr("Browse…"); clicked => { SettingsState.browse(item.id); } } }
            }
        }
    }
}

component ToolRow inherits Rectangle {
    in property <string> name;
    in property <string> hint;
    in property <string> status;
    in property <bool> installed;
    in property <string> tool;
    min-height: 58px;
    HLine { y: parent.height - 1px; }
    HorizontalLayout {
        spacing: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.name; font-weight: 500; color: Theme.ink; }
            Text { text: root.hint; font-size: 12.5px; color: Theme.mut; wrap: word-wrap; }
        }
        Text { text: root.status; width: 260px; font-size: 12.5px; color: root.installed ? Theme.ok : Theme.mut; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
        VerticalLayout {
            alignment: center;
            Btn {
                small: true;
                text: root.installed ? @tr("Update") : @tr("Install");
                clicked => { if !SettingsState.tool-busy { SettingsState.install-tool(root.tool); } }
            }
        }
    }
}

export component SettingsPage inherits HorizontalLayout {
    // Sections.
    Rectangle {
        width: 230px;
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.ln; }
        VerticalLayout {
            padding: 8px;
            padding-top: 12px;
            spacing: 2px;
            alignment: start;
            for name[i] in SettingsState.categories: CategoryItem {
                text: name;
                active: SettingsState.search == "" && SettingsState.category == i;
                clicked => {
                    SettingsState.search = "";
                    SettingsState.category = i;
                    SettingsState.category-selected(i);
                }
            }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        // Header: search and page actions.
        Rectangle {
            height: 56px;
            HLine { y: parent.height - 1px; }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 16px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    LineEdit {
                        width: 320px;
                        placeholder-text: @tr("Search all settings");
                        text <=> SettingsState.search;
                        edited => { SettingsState.search-changed(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; Switch { checked <=> SettingsState.show-advanced; toggled => { SettingsState.show-advanced-changed(self.checked); } } }
                    Text { text: @tr("Show advanced"); vertical-alignment: center; color: Theme.ink; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Btn { small: true; text: @tr("Reset this page"); clicked => { SettingsState.reset-page(); } } }
                VerticalLayout { alignment: center; Btn { small: true; text: @tr("Copy as JSON"); clicked => { SettingsState.copy-json(); } } }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 12px;
                padding-bottom: 20px;
                alignment: start;

                if SettingsState.search == "": Text {
                    text: SettingsState.categories[SettingsState.category];
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.ink;
                    height: 36px;
                }
                if SettingsState.search == "" && SettingsState.category == 6: VerticalLayout {
                    ToolRow {
                        name: "yt-dlp";
                        tool: "yt-dlp";
                        hint: @tr("Needed for YouTube and other video sites. Downloaded from its official GitHub releases.");
                        status: SettingsState.yt-dlp-status;
                        installed: SettingsState.yt-dlp-installed;
                    }
                    ToolRow {
                        name: "ffmpeg";
                        tool: "ffmpeg";
                        hint: @tr("Optional: best quality (video and audio merged) and MP3 conversion. About 100 MB.");
                        status: SettingsState.ffmpeg-status;
                        installed: SettingsState.ffmpeg-installed;
                    }
                }
                if SettingsState.search == "" && SettingsState.category == 9: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Rules run every day they match. Speed limits and pauses apply between the two times; starting, stopping, reconnecting and turning off happen at the first time.");
                        color: Theme.mut;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                    for rule[i] in SettingsState.rules: Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.ln;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            VerticalLayout { alignment: center; Switch { checked: rule.enabled; toggled => { SettingsState.rule-changed(i, "enabled", self.checked ? "true" : "false"); } } }
                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                    width: 150px;
                                    model: [@tr("Every day"), @tr("Weekdays"), @tr("Weekends"), @tr("Monday"), @tr("Tuesday"), @tr("Wednesday"), @tr("Thursday"), @tr("Friday"), @tr("Saturday"), @tr("Sunday")];
                                    current-index: rule.days;
                                    selected => { SettingsState.rule-changed(i, "days", self.current-index); }
                                }
                            }
                            VerticalLayout { alignment: center; LineEdit { width: 70px; text: rule.from; placeholder-text: "09:00"; edited(t) => { SettingsState.rule-changed(i, "from", t); } } }
                            if rule.action <= 1: HorizontalLayout {
                                spacing: 8px;
                                Text { text: "→"; vertical-alignment: center; color: Theme.mut; }
                                VerticalLayout { alignment: center; LineEdit { width: 70px; text: rule.to; placeholder-text: "18:00"; edited(t) => { SettingsState.rule-changed(i, "to", t); } } }
                            }
                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                    width: 200px;
                                    model: [@tr("Limit the speed to"), @tr("Pause everything"), @tr("Start all downloads"), @tr("Pause all downloads"), @tr("Get a new IP"), @tr("Turn off the computer")];
                                    current-index: rule.action;
                                    selected => { SettingsState.rule-changed(i, "action", self.current-index); }
                                }
                            }
                            if rule.action == 0: HorizontalLayout {
                                spacing: 4px;
                                VerticalLayout { alignment: center; SpinBox { width: 120px; minimum: 1; maximum: 10000000; value: rule.value; edited(v) => { SettingsState.rule-changed(i, "value", v); } } }
                                Text { text: "KB/s"; vertical-alignment: center; color: Theme.mut; font-size: 12.5px; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 6px;
                                    background: rm-ta.has-hover ? Theme.trk : transparent;
                                    rm-ta := TouchArea { mouse-cursor: pointer; clicked => { SettingsState.rule-remove(i); } }
                                    Icon { width: 16px; height: 16px; commands: Icons.trash; }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Btn { small: true; icon: Icons.plus; text: @tr("Add a rule"); clicked => { SettingsState.rule-add(); } }
                    }
                    Rectangle { height: 8px; }
                }
                for item in SettingsState.items: VerticalLayout {
                    if item.first-in-group && SettingsState.search != "": Text {
                        text: item.group;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.mut;
                        height: 34px;
                        vertical-alignment: bottom;
                    }
                    ItemRow { item: item; }
                }
                if SettingsState.items.length == 0 && SettingsState.search != "": Text {
                    text: @tr("No setting matches. Try \"speed\", \"captcha\" or \"folder\".");
                    color: Theme.mut;
                    height: 50px;
                    vertical-alignment: center;
                }
                if SettingsState.hidden-advanced > 0: Text {
                    text: @tr("{} advanced options hidden. Turn on Show advanced to see them.", SettingsState.hidden-advanced);
                    color: Theme.mut;
                    font-size: 12.5px;
                    height: 40px;
                    vertical-alignment: center;
                }
                Rectangle { height: 12px; }
                Text { text: @tr("Settings file: {}", SettingsState.config-path); font-size: 12px; color: Theme.mut; wrap: word-wrap; }
            }
        }
    }
}
